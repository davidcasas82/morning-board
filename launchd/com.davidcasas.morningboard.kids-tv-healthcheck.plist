<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local healthcheck for the kids' TVs. User LaunchAgent for
  ~/Library/LaunchAgents/. Replace __REPO__ and __HOME__. No sudo.
  Every 5 minutes it runs `kids-tv.py healthcheck` with no slot argument. The script
  reads schedule.json (and optional times.json) and runs the on check a few
  minutes after alarm, and the off check at leaveBy plus OFF_GRACE, each once
  per day. Most runs find nothing due and exit 0. It does not talk to a TV or
  a speaker. The evening check is a separate plist at 20:45.
  Do not load this until asked. See README, "Health check", for the install
  and uninstall steps, which keep a backup.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.davidcasas.morningboard.kids-tv-healthcheck.plist
  Stop it with:
    launchctl bootout gui/$(id -u)/com.davidcasas.morningboard.kids-tv-healthcheck
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davidcasas.morningboard.kids-tv-healthcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__REPO__/scripts/kids-tv.py</string>
    <string>healthcheck</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kids-tv-healthcheck.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kids-tv-healthcheck.err</string>
</dict>
</plist>

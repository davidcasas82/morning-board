<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  NOT LIVE YET. The kids-tv job run through MorningBoardTVHelper.app,
  so the Local Network permission belongs to that app bundle instead of to
  com.apple.python3. Same schedule as com.davidcasas.morningboard.kids-tv.plist:
  `kids-tv.py tick` once a minute and at login. It replaces that job; never load
  both. See README, "Local Network helper app".
  Build with scripts/build-kids-tv-helper.sh, copy the app to __HOME__/Applications,
  then replace __REPO__ and __HOME__ and put this in ~/Library/LaunchAgents/.
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.davidcasas.morningboard.kids-tv-helper.plist
  Stop it with:
    launchctl bootout gui/$(id -u)/com.davidcasas.morningboard.kids-tv-helper
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davidcasas.morningboard.kids-tv-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/MorningBoardTVHelper.app/Contents/MacOS/kids-tv-helper</string>
    <string>__REPO__/scripts/kids-tv.py</string>
    <string>tick</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.davidcasas.morningboard.kidstv-helper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/kids-tv-morning-board.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/kids-tv-morning-board.err</string>
</dict>
</plist>
